<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gitruvian.Desktop.ViewModels"
             x:Class="Gitruvian.Desktop.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <Panel>
    <StackPanel IsVisible="{Binding IsEmpty}" Margin="12" Spacing="6">
      <TextBlock Classes="heading" Text="Histórico vazio" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Cada proposta, aplicação, teste, commit, reversão, importação e exportação aparece aqui." />
    </StackPanel>
    <DockPanel IsVisible="{Binding !IsEmpty}" Margin="6">
      <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"
                 Text="Trilha de auditoria deste repositório (mais recente primeiro). Enter ou duplo clique abre a proposta do evento." />
      <ListBox x:Name="EventsList" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Classes="compact"
               AutomationProperties.Name="Histórico de eventos" KeyDown="OnKeyDown" DoubleTapped="OnDoubleTapped">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:EventItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EventItem">
            <StackPanel Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding When}" Classes="muted mono" FontSize="11" />
                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Text="{Binding Proposal}" Classes="muted mono" FontSize="11" />
              </StackPanel>
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Panel>
</UserControl>
