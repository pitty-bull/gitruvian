<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aplicativo de desktop (Avalonia). Gera Gitruvian.exe; o instalador sai do vpk (scripts/package.*). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Gitruvian</AssemblyName>
    <RootNamespace>Gitruvian.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gitruvian.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Publicação: um único Gitruvian.exe autossuficiente (não exige .NET instalado na máquina).
         As bibliotecas nativas (Skia, HarfBuzz, SQLite, ANGLE) vão embutidas e são extraídas na primeira
         execução para a pasta temporária do usuário. Sem trimming: Avalonia, o SDK da Anthropic e o
         CommunityToolkit usam reflexão. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gitruvian.Core\Gitruvian.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gitruvian.Desktop.Tests" />
  </ItemGroup>
  <!-- Skia e HarfBuzz publicam símbolos nativos (.pdb, ~100 MB) que não servem ao usuário; o exe deve sair sozinho. -->
  <Target Name="RemoveNativeSymbols" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PublishedPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdb)" />
  </Target>
</Project>
