# Gitruvian — configuração local. Copie para .env (scripts/install.* já faz isso).
# App instalado (Setup.exe): crie o arquivo em %APPDATA%\gitruvian\.env e reinicie o Gitruvian.
# O .env nunca é indexado, nunca é enviado ao modelo e nunca deve ser commitado.
#
# Onde o .env é procurado (o primeiro que define a chave vence):
#   1. variáveis de ambiente do processo
#   2. o arquivo apontado por GITRUVIAN_ENV_FILE (se definido, é o ÚNICO arquivo lido)
#   3. ./.env na pasta onde o comando é executado
#   4. %APPDATA%\gitruvian\.env (Windows) ou ~/.config/gitruvian/.env (Linux/macOS)

# ---------------------------------------------------------------- Modelo
# none           -> padrão. Sem modelo: tudo local, você cola o diff (modo manual).
# openai_compat  -> servidor local compatível com OpenAI (Ollama, LM Studio, llama.cpp, vLLM).
# command        -> qualquer programa local que leia o prompt no stdin e escreva a resposta.
# anthropic      -> API da Anthropic (o SDK oficial já vem no app; exige GITRUVIAN_ALLOW_REMOTE=1).
GITRUVIAN_PROVIDER=none

# Nome do modelo. Para anthropic, o padrão é claude-opus-5-5.
# Para Ollama, por exemplo: qwen2.5-coder:7b
GITRUVIAN_MODEL=

# Provedores que enviam código para fora desta máquina (anthropic, ou openai_compat
# apontando para um host que não seja localhost) só funcionam com consentimento explícito:
GITRUVIAN_ALLOW_REMOTE=0

# Segredo: chave da API da Anthropic (somente para GITRUVIAN_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# openai_compat: endereço base (sem /chat/completions) e chave opcional.
GITRUVIAN_OPENAI_BASE_URL=http://localhost:11434/v1
GITRUVIAN_OPENAI_API_KEY=

# command: comando que recebe o prompt no stdin. Ex.: ollama run qwen2.5-coder:7b
GITRUVIAN_MODEL_COMMAND=

# Tempo máximo de uma chamada ao modelo, em segundos.
GITRUVIAN_TIMEOUT=120
# Quantidade máxima de caracteres de código enviada como contexto ao modelo.
GITRUVIAN_MAX_CONTEXT_CHARS=24000

# ---------------------------------------------------------------- Testes
# Sobrescreve o comando de testes salvo por repositório (Repositório › Configurações no app).
# Roda sem shell, na raiz do repositório. Ex.: dotnet test
GITRUVIAN_TEST_COMMAND=
GITRUVIAN_TEST_TIMEOUT=600

# ---------------------------------------------------------------- Dados
# Por padrão os dados ficam em <repositório>/.gitruvian/. Defina uma pasta para
# guardá-los fora dos repositórios (uma subpasta por repositório).
GITRUVIAN_DATA_DIR=

# ---------------------------------------------------------------- Atualizações
# O app instalado pode verificar novas versões em github.com/pitty-bull/gitruvian/releases.
# vazio -> pergunta uma vez na tela inicial; 1 -> verifica ao abrir; 0 -> nunca verifica sozinho
# (o menu Ajuda › Verificar atualizações continua funcionando). Nenhum dado seu é enviado.
GITRUVIAN_AUTO_UPDATE=
# Fonte alternativa de atualizações: URL http(s) ou pasta local com os arquivos do vpk (releases.win.json).
GITRUVIAN_UPDATE_URL=

# ---------------------------------------------------------------- Publicação (só para quem publica versões)
# Segredo: token do GitHub usado por scripts/publish-release.ps1 (permissão Contents: read and write).
# O app nunca lê esta chave.
GITHUB_TOKEN=
