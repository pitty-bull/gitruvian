<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testes do núcleo. xUnit v3 exige projeto executável. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gitruvian.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gitruvian.Core\Gitruvian.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Gitruvian.Core" />
  </ItemGroup>
</Project>
